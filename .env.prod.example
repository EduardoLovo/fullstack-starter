# Variáveis do ambiente de produção (compose.prod.yaml).
#   cp .env.prod.example .env.prod   e troque TODOS os valores marcados.
# O .env.prod nunca vai para o git.
#
# Gere segredos com:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"

# Porta pública do Nginx (em um servidor, normalmente 80)
HTTP_PORT=80

# Endereço público da aplicação (link do e-mail de redefinição de senha)
APP_URL=http://localhost

# true quando o site estiver em HTTPS (o cookie de sessão só trafega criptografado).
# Em http://localhost os navegadores aceitam cookie Secure, então pode ficar true.
COOKIE_SECURE=true

# PostgreSQL  [TROQUE]
POSTGRES_USER=starter
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=starter

# Redis  [TROQUE]
REDIS_PASSWORD=troque-esta-senha

# API  [TROQUE: mínimo de 32 caracteres]
JWT_SECRET=troque-este-segredo-por-um-valor-longo-e-aleatorio

# Admin criado pelo seed  [TROQUE]
SEED_ADMIN_EMAIL=admin@seu-dominio.com
SEED_ADMIN_PASSWORD=troque-esta-senha-1

# SMTP real (SendGrid, Amazon SES, Resend, Mailgun...)
# Para testar localmente, use o Mailpit:  SMTP_HOST=mailpit, SMTP_PORT=1025
# e suba com:  --profile local
SMTP_HOST=smtp.seu-provedor.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Fullstack Starter <no-reply@seu-dominio.com>

# Grafana (compose.monitoring.yaml)  [TROQUE]
GRAFANA_ADMIN_PASSWORD=troque-esta-senha
