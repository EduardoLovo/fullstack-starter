# Usado apenas ao rodar a API FORA do Docker (npm run dev na sua máquina).
# Dentro do Docker, o compose.yaml injeta essas variáveis apontando para os containers.

NODE_ENV=development
PORT=3333
LOG_LEVEL=info

DATABASE_URL=postgresql://starter:starter_dev_password@localhost:5432/starter
REDIS_URL=redis://:redis_dev_password@localhost:6379

# Gere um segredo forte com: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=troque-este-segredo-por-um-valor-longo-e-aleatorio
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=7

CORS_ORIGIN=http://localhost:3000
COOKIE_SECURE=false

# Admin criado pelo seed (npm run db:seed)
SEED_ADMIN_EMAIL=admin@starter.dev
SEED_ADMIN_PASSWORD=Admin@12345
