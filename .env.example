# Copie para .env:  cp .env.example .env

# PostgreSQL
POSTGRES_USER=starter
POSTGRES_PASSWORD=starter_dev_password
POSTGRES_DB=starter
POSTGRES_PORT=5432

# Redis
REDIS_PASSWORD=redis_dev_password
REDIS_PORT=6379

# API
# Gere um segredo forte com: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=troque-este-segredo-por-um-valor-longo-e-aleatorio

# Admin criado pelo seed:  docker compose exec api npm run db:seed
SEED_ADMIN_EMAIL=admin@starter.dev
SEED_ADMIN_PASSWORD=Admin@12345
